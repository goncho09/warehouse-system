generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  FOOD
  NO_FOOD
  CONGELADO
  REFRIGERADO
}

enum CNTStatus {
  ACTIVO
  FINALIZADO
}

enum LocationType {
  PICKING
  EN_PUERTA
  FLOTANTE
  AVERIAS
}

enum OrderStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
}

enum Destination {
  LA_BLANQUEADA
  CARRASCO_NORTE
  TRES_CRUCES
  SAYAGO
  CIUDAD_DE_LA_COSTA
  MALVIN_NORTE
  AGUADA
  BRAZO_ORIENTAL
}

model Product {
  id              Int             @id @default(autoincrement())
  productId       String          @unique
  barCode         String          @unique
  description     String
  category        Category
  unitsPerDisplay Int

  cntItems CNTItem[]
  entries  Entry[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  code String       @id
  type LocationType

  chamber  String?
  row      String?
  position String?
  height   String?

  cnts CNT[]

  createdAt DateTime @default(now())
}

model CNT {
  id   Int    @id @default(autoincrement())
  code String @unique

  status CNTStatus @default(ACTIVO)

  locationCode String? 
  location Location? @relation(fields: [locationCode], references: [code])

  items   CNTItem[]
  entries Entry[]

  movements CNTMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CNTItem {
  id Int @id @default(autoincrement())

  cntId Int
  cnt   CNT    @relation(fields: [cntId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  lot     String
  dueDate DateTime
  count   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cntId, productId])
  @@index([productId])
}

model Entry {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  cntId Int
  cnt   CNT    @relation(fields: [cntId], references: [id])

  lot     String
  dueDate DateTime
  count   Int

  entryDate DateTime @default(now())

  @@index([productId])
  @@index([cntId])
}

model CNTMovement {
  id               Int      @id @default(autoincrement())
  cntId            Int
  fromLocationCode String?
  toLocationCode   String
  createdAt        DateTime @default(now())

  cnt CNT @relation(fields: [cntId], references: [id], onDelete: Cascade)

  @@index([cntId])
}

model Order {
  id              Int         @id @default(autoincrement())
  stoCode         String      @unique
  preparationCode String      @unique
  destination     Destination
  status          OrderStatus @default(PENDIENTE)
  departureDate   DateTime
  category Category
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@unique([destination, category, departureDate])
  @@index([departureDate])
  @@index([status])
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  requestedCount Int
  pickedCount    Int @default(0)
  cancelledCount Int @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
  @@index([productId])
}